{
  "title": "Robot Shop - Requests, Errors, Latency",
  "uid": "robot-shop-red",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second (synthetic probes)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time(probe_success{job=\"robot-shop-probe\"}[1m])) / 60",
          "legendFormat": "probes/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(avg_over_time(probe_success{job=\"robot-shop-probe\"}[1m])))",
          "legendFormat": "errors %"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (seconds)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"robot-shop-probe\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}