      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Synthetic Probe Failure Rate (%)",
          "description": "Percentage of failed Blackbox endpoint probes; not the percentage of all application HTTP requests returning errors.",
