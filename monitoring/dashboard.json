            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * (1 - avg(avg_over_time(probe_success{job=\"robot-shop-probe\"}[1m])))",
                        "format": "time_series",
                        "interval": "",
                        "legendFormat": "Probe failures (%)",
                        "range": true
